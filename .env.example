# AI Provider — DeepSeek (OpenAI-compatible) is used in V1
AI_API_KEY=                                       # Required: your DeepSeek API key (sk-...)
AI_MODEL=deepseek-chat                            # Model to use (deepseek-chat recommended)
AI_BASE_URL=https://api.deepseek.com/v1           # DeepSeek API base URL (OpenAI-compatible)
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# TTS Provider — OpenAI-compatible TTS for 「点我听」 pronunciation (v0.3.0+)
# Supports AiHubMix or any OpenAI-compatible proxy.  Uses POST /v1/audio/speech.
TTS_API_KEY=                                      # Required: your TTS provider API key
TTS_BASE_URL=https://aihubmix.com/v1              # TTS API base URL (OpenAI-compatible)
TTS_MODEL=gpt-4o-mini-tts                         # TTS model ID
TTS_VOICE=alloy                                   # Voice name (alloy / echo / fable / onyx / nova / shimmer)

# App config
NEXT_PUBLIC_APP_NAME=WordCard
NEXT_PUBLIC_APP_URL=http://localhost:3000
