AI_BASE_URL=https://api.deepseek.com/v1           # DeepSeek API base URL (OpenAI-compatible)
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3

# App config
NEXT_PUBLIC_APP_NAME=WordCard
NEXT_PUBLIC_APP_URL=http://localhost:3000
